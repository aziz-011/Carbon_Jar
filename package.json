{
  "name": "carbon-jar",
  "private": true,
  "version": "1.0.0",
  "description": "Plateforme de comptabilité carbone (GHG Protocol) : émissions, énergie, coûts, scopes et plan de réduction",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build:artifact": "tsc -b && vite build --outDir dist-artifact && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^4.4.168",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.2"
  }
}
